# 复制为 .env 后填写。密钥只放在服务端，不要写入 demo/*.js。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=DeepSeek

HOST=0.0.0.0
PORT=8765
PUBLIC_HOST=demo.example.com

# 公网部署保护。0表示关闭应用层限流（仅建议本机调试使用）。
DEMO_RATE_LIMIT_PER_MINUTE=120
DEMO_MAX_BODY_BYTES=16384

# 比特币主网链上数据。可替换为自建Esplora节点以获得更高可用性与隐私。
BITCOIN_LIVE_ENABLED=1
BITCOIN_API_BASE_URL=https://blockstream.info/api
BITCOIN_API_TIMEOUT=20
BITCOIN_CACHE_TTL=300
BITCOIN_MAX_TRANSACTIONS=75
BITCOIN_MAX_PAGES=3
BITCOIN_INFERENCE_DEVICE=cpu
